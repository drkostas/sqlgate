{
  "name": "@drkostas/sqlgate",
  "version": "0.2.0",
  "description": "Serve a Postgres or MySQL database you host yourself to serverless apps over HTTPS, in the shape the Neon driver already speaks",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "sqlgate": "src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "for f in src/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "keywords": [
    "postgres",
    "mysql",
    "neon",
    "serverless",
    "vercel",
    "self-hosted",
    "gateway",
    "cloudflare-tunnel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drkostas/sqlgate.git"
  },
  "license": "MIT"
}
